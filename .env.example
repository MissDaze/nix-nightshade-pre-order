# ── Square credentials ─────────────────────────────────────────────────────────
# SANDBOX MODE — swap for production before going live
SQUARE_ACCESS_TOKEN=sandbox-your-access-token-here
SQUARE_LOCATION_ID=your-location-id-here

# Set to 'production' when going live
SQUARE_ENVIRONMENT=sandbox
# SQUARE_ENVIRONMENT=production

# ── Server ─────────────────────────────────────────────────────────────────────
# PORT is set automatically by Railway — do not set it manually there
PORT=3000
